{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "TARS",
    "version": "0.1.0",
    "identifier": "com.tars.assistant",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "TARS",
                "width": 800,
                "height": 700,
                "transparent": true,
                "decorations": false,
                "alwaysOnTop": true,
                "fullscreen": false,
                "resizable": false,
                "skipTaskbar": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0",
                    "libayatana-appindicator3-1"
                ]
            }
        }
    }
}